# --- App ---
# Base public URL of the deployed app (used for the cron endpoint and links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Found in your Supabase project settings under "API".
# NEXT_PUBLIC_* keys are intentionally public (client identifier, NOT an auth boundary).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Grants admin access that bypasses RLS.
# NEVER expose this to the browser. Used only by the cron check runner.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron ---
# Shared secret that the scheduler must present as `Authorization: Bearer <value>`
# when calling /api/cron/check. Generate with `openssl rand -hex 32`.
CRON_SECRET=
